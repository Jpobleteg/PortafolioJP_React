{
  "name": "portafolio-react",
  "version": "1.0.0",
  "description": "Portafolio personal en React + Bootstrap con pruebas Jasmine/Karma (DSY1104 - Evaluación Formativa 2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "karma start karma.conf.cjs",
    "test:watch": "karma start karma.conf.cjs --no-single-run",
    "test:all": "karma start karma.conf.cjs --browsers ChromeHeadlessCI,FirefoxHeadless",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jasmine": "^7.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/webpack-env": "^1.18.8",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.1",
    "css-loader": "^7.1.5",
    "gh-pages": "^6.3.0",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "^5.1.0",
    "karma-spec-reporter": "^0.0.37",
    "karma-webpack": "^5.0.1",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "webpack": "^5.112.2"
  },
  "private": true,
  "type": "module",
  "homepage": "https://TU-USUARIO.github.io/portafolio-react/"
}